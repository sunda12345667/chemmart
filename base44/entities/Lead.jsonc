{
  "name": "Lead",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "whatsapp_checkout",
        "bulk_quote",
        "technical_inquiry",
        "machine_sourcing",
        "product_inquiry",
        "catalog_download",
        "abandoned_cart"
      ],
      "description": "Lead type"
    },
    "reference_id": {
      "type": "string",
      "description": "Unique reference ID"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "delivery_state": {
      "type": "string"
    },
    "delivery_city": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "packaging_size": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "is_quote": {
            "type": "boolean"
          }
        }
      }
    },
    "estimated_total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "quoted",
        "negotiating",
        "won",
        "lost"
      ],
      "default": "new"
    },
    "assigned_admin": {
      "type": "string"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "internal_notes": {
      "type": "string"
    },
    "activity_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "whatsapp_message": {
      "type": "string",
      "description": "The formatted WhatsApp message sent"
    }
  },
  "required": [
    "type",
    "customer_name"
  ]
}