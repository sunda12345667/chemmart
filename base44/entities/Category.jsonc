{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category name"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug"
    },
    "description": {
      "type": "string",
      "description": "Category description"
    },
    "image_url": {
      "type": "string",
      "description": "Category image"
    },
    "icon": {
      "type": "string",
      "description": "Icon name from lucide"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent category ID for subcategories, empty for top-level"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "slug"
  ]
}